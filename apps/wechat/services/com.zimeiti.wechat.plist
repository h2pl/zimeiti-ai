<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zimeiti.wechat</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>src/index.js</string>
    <string>start</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__WECHAT_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>WECHAT_STATE_DIR</key>
    <string>__WECHAT_DIR__/state</string>
    <key>ZIMEITI_API</key>
    <string>__ZIMEITI_API__</string>
  </dict>
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__WECHAT_DIR__/state/bridge.log</string>
  <key>StandardErrorPath</key>
  <string>__WECHAT_DIR__/state/bridge.err.log</string>
</dict>
</plist>
