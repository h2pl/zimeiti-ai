# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage

# 本地配置（放 API key，不入库）
.env
.env.local

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Node
node_modules/
dist/

# 后端运行时会话数据（非源码；对齐上游 Easel .gitignore 的 outputs 规则）
apps/outputs/*
!apps/outputs/.gitkeep
apps/sessions/

# Comet 归档目录内的运行时状态不入库
docs/openspec/changes/archive/*/.comet/
# >>> Comet managed project state >>>
!/.comet/
/.comet/*
!/.comet/config.yaml
# <<< Comet managed project state <<<
_api.log

# 浏览器 E2E 截图
apps/scripts/_*.png
